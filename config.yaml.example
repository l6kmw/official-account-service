app:
  env: dev

http:
  addr: ":8080"

log:
  level: info

# Empty dsn keeps local `make run` on memory storage.
database:
  dsn: ""

# Empty addr disables Redis locks/cache/asynq for local `make run`.
redis:
  addr: ""

security:
  # Stable id of the existing administrator data space. Keep tenant-1 when upgrading.
  admin_user_id: "tenant-1"
  # Required when app.env is prod. For public admin pages, prefer a gateway that injects this header.
  admin_api_key: ""
  # Optional administrator login. Configure all three values together to enable the login page.
  admin_username: ""
  # bcrypt hash, e.g. `htpasswd -bnBC 12 "" "your-password" | tr -d ':\n'`
  admin_password_hash: ""
  # random session signing secret, e.g. `openssl rand -base64 32`
  admin_session_secret: ""

wechat:
  # Leave empty to keep real WeChat calls disabled.
  component_app_id: ""
  component_app_secret: ""
  api_base_url: ""
  component_verify_token: ""
  component_encoding_aes_key: ""
  # base64 encoded 32-byte key, e.g. `openssl rand -base64 32`
  refresh_token_encryption_key: ""

mcp:
  # Legacy tenant-1 compatibility token. Generate per-user MCP tokens in User Management.
  # Do not put any token in admin-config.js.
  token: ""
  path: "/mcp"
