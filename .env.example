APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# docker-compose local defaults
HTTP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_PASSWORD=official_account_password
REDIS_PORT=6379

# Empty DB_DSN keeps local make run on memory storage.
# docker-compose injects postgres://official_account:...@postgres:5432/official_account.
DB_DSN=

# Optional: enables Redis distributed token refresh locking/cache and asynq workers.
# docker-compose injects redis:6379 for the app container.
REDIS_ADDR=

# Optional: enables real WeChat component_access_token and pre_auth_code calls.
WECHAT_COMPONENT_APP_SECRET=
WECHAT_API_BASE_URL=
WECHAT_COMPONENT_APP_ID=
WECHAT_COMPONENT_VERIFY_TOKEN=
WECHAT_COMPONENT_ENCODING_AES_KEY=
WECHAT_REFRESH_TOKEN_ENCRYPTION_KEY=
